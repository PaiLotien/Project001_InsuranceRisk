px; color: #666;\">预警阈值</td>\n                    <td style=\"padding: 6px 12px;\">90%</td>\n                </tr>\n                <tr style=\"background: #f8f9fa;\">\n                    <td style=\"padding: 6px 12px; color: #666;\">偏离幅度</td>\n                    <td style=\"padding: 6px 12px; color: #ffc107; font-weight: bold;\">+1.0 个百分点</td>\n                </tr>\n            </table>\n    \n            <h4 style=\"margin: 16px 0 8px; color: #555;\">明细指标</h4>\n            <table style=\"width: 100%; border-collapse: collapse; font-size: 14px;\">\n                <tr>\n                    <td style=\"padding: 4px 12px; color: #666;\">预期赔付率</td>\n                    <td style=\"padding: 4px 12px;\">0.0%</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 4px 12px; color: #666;\">成本率1（费用率）</td>\n                    <td style=\"padding: 4px 12px;\">0.0%</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 4px 12px; color: #666;\">预期成本率</td>\n                    <td style=\"padding: 4px 12px;\"><strong>= 0.0%</strong></td>\n                </tr>\n            </table>\n            \n            <h3 style=\"margin: 20px 0 12px 0; color: #333; border-bottom: 2px solid #333; padding-bottom: 8px;\">\n                行动要求\n            </h3>\n            <div style=\"background: #fffef5; padding: 14px; border-radius: 6px; font-size: 14px;\">\n                <p style=\"margin: 0 0 8px 0;\"><strong>【提示】此为黄色预警，请于48小时内关注并评估风险态势。</strong></p>\n                <p style=\"margin: 4px 0;\">响应时效：<strong>48 小时内</strong></p>\n                <p style=\"margin: 4px 0;\">关注部门：<strong>车险部</strong></p>\n            </div>\n    \n        </div>\n\n        <!-- 页脚 -->\n        <div style=\"background: #f5f5f5; padding: 14px 24px; border-radius: 0 0 8px 8px; font-size: 12px; color: #999; border: 1px solid #e0e0e0; border-top: none;\">\n            <p style=\"margin: 0 0 4px 0;\">此邮件由<strong>渤海财险车险智能风控系统（IRDS）</